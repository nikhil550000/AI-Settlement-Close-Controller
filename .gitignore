# Secrets: never committed.
.env

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Mutated at runtime, rebuilt from the committed dataset.
*.sqlite
*.sqlite3
ledger.db

# Run scratch output. `tools/` is the tracked home for anything capability-bearing:
# Nothing capability-bearing may live outside the repository, and the
# adversarial-set builder and the performance harness both produce committed claims.
/scratch/
/.run/

.claude

# Archify diagram workspace: the delivered HTML viewers, their JSON specs and the
# visual-check sidecars are large build products. The README ships the rendered
# PNGs from assets/diagrams/ instead.
/docs/diagrams/

# Working documents that drove the build, kept locally as evidence but not
# part of what the repository presents: the standing brief each coding session
# opened with, the append-only session log, and the pitch-video script.
/docs/AGENT.md
/docs/BUILDLOG.md
/PITCH.md

# The locked design document the build was written against. A working artifact,
# kept locally: the code and the docs now state their own rules rather than
# citing it.
/spec.md
